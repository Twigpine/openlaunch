{
  "name": "openlaunch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --conditions=react-server --tsconfig tsconfig.test.json --test \"src/**/*.test.ts\" && npm run test:solana && node scripts/solana-checks.mjs --ci",
    "test:solana": "tsc --noEmit -p packages/solana-sdk/tsconfig.json && tsx --test \"packages/solana-sdk/tests/*.test.ts\" && node --experimental-strip-types --test \"../packages/solana-model/*.test.mjs\"",
    "test:solana-runtime": "node scripts/solana-checks.mjs",
    "migrate": "node scripts/migrate.mjs"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "@solana/keys": "8.5.0",
    "@solana/web3.js": "3.0.2",
    "@solana/wallet-standard-features": "1.5.0",
    "@wallet-standard/app": "1.1.1",
    "@wallet-standard/base": "1.1.1",
    "@wallet-standard/features": "1.1.1",
    "@aws-sdk/client-s3": "^3.1127.0",
    "@base-ui/react": "^1.8.0",
    "@coinbase/wallet-sdk": "^4.3.7",
    "@number-flow/react": "^0.6.2",
    "@tanstack/react-query": "^5.91.3",
    "buffer": "6.0.3",
    "clsx": "^2.1.1",
    "d3-force": "^3.0.0",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.42.0",
    "motion": "^13.2.0",
    "next": "^16.3.8",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.6.0",
    "viem": "^2.47.6",
    "wagmi": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "overrides": {
    "use-sync-external-store": "^1.4.0"
  }
}
